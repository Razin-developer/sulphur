# Keep this file safe to commit. Copy it to .env and replace only the values.
# Private .env must never be committed, pasted in chat, or sent to the browser.

# Supabase server database: Dashboard → Connect → Session pooler.
# Keep reserved password characters URL-encoded in the connection string.
# Supabase Dashboard → Connect → Session pooler for this long-running Hono service.
DATABASE_URL=postgresql://postgres.ecgvwrmmohxhrblsolba:URL_ENCODED_DB_PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres
# Generate at least 32 random characters; use a different secret in each environment.
BETTER_AUTH_SECRET=replace-with-a-32-character-secret
# Public server address for Better Auth callbacks; no trailing slash.
BETTER_AUTH_URL=http://localhost:8787
WEB_ORIGIN=http://localhost:5173
# Google: Cloud Console → OAuth web client. Callback: /api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GitHub: Settings → Developer settings → OAuth App. Callback: /api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
VITE_AUTH_URL=http://localhost:8787
# Dedicated credentials for /admin. Never expose these to Vite or commit them.
ADMIN_MAIL=owner@example.com
ADMIN_PASS=replace-with-a-long-random-admin-password
# Gmail development SMTP: smtp.gmail.com, port 587, account email as user,
# and a Google App Password as SMTP_PASSWORD — never your normal Google password.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Must be an address the SMTP provider permits this account to send from.
SMTP_FROM=Sulphur <no-reply@example.com>
# Stripe server-only subscription checkout configuration. Create recurring Prices
# in Stripe for each paid plan; never expose STRIPE_SECRET_KEY to Vite/browser code.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Configure Stripe to POST these events to /api/billing/stripe/webhook:
# checkout.session.completed, invoice.payment_succeeded, invoice.payment_failed.
# The endpoint verifies Stripe's signature before changing billing state or emailing users.
STRIPE_PRICE_DEVELOPER_MONTHLY=
STRIPE_PRICE_DEVELOPER_YEARLY=
STRIPE_PRICE_TEAM_MONTHLY=
STRIPE_PRICE_TEAM_YEARLY=
STRIPE_PRICE_SCALE_MONTHLY=
STRIPE_PRICE_SCALE_YEARLY=
# Server-only OpenAI credentials for the in-app Android testing agent.
OPENAI_API_KEY=
# Optional. Defaults to gpt-5-mini.
OPENAI_MODEL=
# CoTester credits are computed from every Responses API call in a run.
# Defaults: 1 credit / 1K input tokens, 4 credits / 1K output tokens.
AI_CREDITS_PER_1K_INPUT_TOKENS=1
AI_CREDITS_PER_1K_OUTPUT_TOKENS=4
